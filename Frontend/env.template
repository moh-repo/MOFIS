# Frontend environment — how the API base URL is chosen.
#
# Nothing reads this file. It documents src/environments/*.ts, which is what the
# build uses (angular.json fileReplacements pick the file per configuration).
#
#   environment.ts          (ng serve)       apiUrl: ''  — same origin; proxy.conf.json
#                                            forwards /mohe to http://localhost:8082
#   environment.prod.ts     (production)     apiUrl follows window.location.origin
#   environment.staging.ts  (staging)        same as production
#
# Same-origin deployment (UI and API behind one host, API under /mohe):
#   leave splitOriginApi = '' in environment.prod.ts — nothing to configure.
#
# Split-origin deployment (UI on one host, API on another):
#   set splitOriginApi in environment.prod.ts to the API origin only, no path,
#   no trailing slash, e.g. 'https://api.example.gov', and add the UI origin to
#   the backend's CORS_ALLOWED_ORIGINS.
#   Also add the API origin to connect-src in the Content-Security-Policy meta tag
#   in src/index.html (connect-src 'self' https://api.example.gov). Without it the
#   browser blocks every API call. `npm run check-dist` fails a production build
#   whose splitOriginApi is not in connect-src.
#
# Do not commit real production hostnames or secrets here or in the environment files.
