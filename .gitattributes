# Normalise line endings in the repository to LF; check out as the platform default.
# Ends the "LF will be replaced by CRLF" warnings on every touched file.
* text=auto

# Scripts that must keep their own endings
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
mvnw  text eol=lf

# Binary — never normalised
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.docx binary
*.xls binary
*.xlsx binary
*.wasm binary
*.jar binary
*.rar binary
*.zip binary
