        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_DEDUCTIONS}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00">
        <reportElement x="290" y="265" width="105" height="14"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{deductions} != null ? $F{deductions} : java.math.BigDecimal.ZERO]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="235" y="265" width="50" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_CURRENCY}]]></textFieldExpression>
