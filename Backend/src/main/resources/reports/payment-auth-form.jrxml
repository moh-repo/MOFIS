        <textFieldExpression><![CDATA[$P{LBL_C1} + "  <b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{recipientName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{recipientName}) : "") + "</b>  " + $P{LBL_C1_TAIL}]]></textFieldExpression>
      </textField>
      <textField>
