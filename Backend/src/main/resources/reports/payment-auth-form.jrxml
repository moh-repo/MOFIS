      <!-- Deductions note, right-hand marginal cell -->
      <textField>
        <reportElement x="60" y="249" width="165" height="30"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_DEDUCT_NOTE}]]></textFieldExpression>
