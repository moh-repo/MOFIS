      </textField>
      <textField>
        <reportElement style="cell" x="0" y="92" width="30" height="26"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["١"]]></textFieldExpression>
      </textField>

      <!-- Blank continuation row, as on the printed form -->
      <textField><reportElement style="cell" x="477" y="118" width="78" height="24"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
      <textField><reportElement style="cell" x="357" y="118" width="120" height="24"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
      <textField><reportElement style="cell" x="295" y="118" width="62" height="24"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
      <textField><reportElement style="cell" x="237" y="118" width="58" height="24"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
      <textField><reportElement style="cell" x="30" y="118" width="207" height="24"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
      <textField><reportElement style="cell" x="0" y="118" width="30" height="24"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>

      <!-- Total row -->
      <textField pattern="#,##0.00">
        <reportElement style="cell" x="477" y="142" width="78" height="22"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{originalAmount} != null ? $F{originalAmount} : java.math.BigDecimal.ZERO]]></textFieldExpression>
      </textField>
      <!--
        The total in words — التفقيط. It shares the cell with the word "total"
        because that is the row the figure is on, and the point of writing an amount
        out is that it sits beside the figure it guards: a digit changed after
        signing no longer agrees with the words next to it.
      -->
      <textField>
        <reportElement style="cell" x="0" y="142" width="477" height="22"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_TOTAL} + "   "
            + ($P{AMOUNT_IN_WORDS} != null && !$P{AMOUNT_IN_WORDS}.isEmpty()
                ? "( " + $P{LBL_AMOUNT_WORDS} + ": " + $P{AMOUNT_IN_WORDS} + " )" : "")]]></textFieldExpression>
      </textField>

      <!-- Signature row: three prescribed signatories -->
      <textField>
        <reportElement style="cell" x="370" y="164" width="185" height="52"/>
        <textElement textAlignment="Center" verticalAlignment="Top" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SIG_HEAD} + "\n\n____________________"]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="185" y="164" width="185" height="52"/>
        <textElement textAlignment="Center" verticalAlignment="Top" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SIG_DG} + "\n\n____________________"]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="0" y="164" width="185" height="52"/>
        <textElement textAlignment="Center" verticalAlignment="Top" runDirection="RTL">
