<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
  "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<!--
  Payment authorisation voucher - "استمارة اعتماد الصرف" (نموذج رقم ١١ حسابات).

  OFFICIAL-LAYOUT:SKIP
  This is a statutory form: its header block, section lettering (أ/ب/ج/د) and
  signature placement are prescribed by the issuing ministry. scripts/apply_official_layout.py
  therefore leaves this file alone instead of replacing the masthead with the
  generic bilingual one used by the analytical reports.

  One record per document; the controller fills it with a single PaymentAuth.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="payment-auth-form"
  pageWidth="595" pageHeight="842"
  orientation="Portrait"
  columnWidth="555" leftMargin="20" rightMargin="20"
  topMargin="10" bottomMargin="15"
  whenNoDataType="AllSectionsNoDetail">

  <!--
    The layout below is drawn right to left, because the form is. Asked for in
    English it is mirrored element by element before compiling — see
    MirroredDesign — so there is one layout to maintain rather than two files
    drifting apart. Opt-in, because the analytical reports are ordinary
    left-to-right layouts that merely carry Arabic text and must not be flipped.
  -->
  <property name="mohe.mirror.for.ltr" value="true"/>

  <!-- STYLES -->
  <style name="defaultStyle" isDefault="true" fontName="Cairo" fontSize="8"/>
  <style name="cell" fontName="Cairo" fontSize="8">
    <box><pen lineWidth="0.5" lineColor="#000000"/></box>
  </style>
  <style name="sectBox" fontName="Cairo" fontSize="8">
    <box><pen lineWidth="0.5" lineColor="#000000"/></box>
  </style>

  <!-- ═══════════════════ PARAMETERS ═══════════════════ -->
  <parameter name="IS_RTL"       class="java.lang.Boolean"><defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression></parameter>
  <parameter name="LANG"         class="java.lang.String"><defaultValueExpression><![CDATA["ar"]]></defaultValueExpression></parameter>
  <parameter name="LOGO_IMAGE"   class="java.io.InputStream"/>
  <parameter name="TITLE_01"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_AR"  class="java.lang.String"><defaultValueExpression><![CDATA["الجمهورية اليمنية"]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_AR"  class="java.lang.String"><defaultValueExpression><![CDATA["وزارة المالية"]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_AR"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_EN"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_EN"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_EN"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_TITLE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="PRINTED_BY"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_DATE"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="FOOTER_TEXT"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_COUNT"    class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_1"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_2"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_3"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_4"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_5"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_1"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_2"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_3"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_4"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_5"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_GENERATED" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_PAGE"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_OF"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_NO_DATA"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <!-- Prescribed form wording. Arabic defaults are the legal text; the English
       equivalents come from ReportParamBuilder when lang=en. -->
  <parameter name="LBL_FORM_SERIAL"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_DOC_TITLE"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_MINISTRY_FLD" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_PROVINCE"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_DEPT"         class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_CHECK_VIA"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_CHECK_BRANCH" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_DEFAULT_BANK" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_DATE"         class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SENT_TO"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_AMOUNT_CUR"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_AMOUNT_WORDS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- The ministry's own currency and the total written out; both supplied by the
       controller, from STUDY_CURRENCY_IN and AmountInWords respectively. -->
  <parameter name="CURRENCY_NAME"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="AMOUNT_IN_WORDS"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_EXPENSE_HEAD" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SUB_1"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SUB_2"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SUB_3"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SUB_4"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_NUMBER"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_NAME"         class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SEQ"          class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIG_HEAD"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIG_DG"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIG_OFFICER"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SEC_A"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_ORIGINAL"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_DEDUCTIONS"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_CURRENCY"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_DEDUCT_NOTE"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_NET_DUE"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIG_ACCT"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SEC_B"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_B1"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_B2"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_B3"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIG_ACCMGR"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SEC_C"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_C1"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_C1_TAIL"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SEC_D"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_D1"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_D2"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_D3"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_D4"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_D4_ID"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <!-- ═══════════════════ FIELDS ═══════════════════ -->
  <field name="id"                class="java.lang.Integer"/>
  <field name="authFormNumber"    class="java.lang.String"/>
  <field name="authDate"          class="java.time.LocalDate"/>
  <field name="studentName"       class="java.lang.String"/>
  <field name="ministryName"      class="java.lang.String"/>
  <field name="deptName"          class="java.lang.String"/>
  <field name="provinceName"      class="java.lang.String"/>
  <field name="bankName"          class="java.lang.String"/>
  <field name="bankBranch"        class="java.lang.String"/>
  <field name="sentTo"            class="java.lang.String"/>
  <field name="paymentPurpose"    class="java.lang.String"/>
  <field name="originalAmount"    class="java.math.BigDecimal"/>
  <field name="deductions"        class="java.math.BigDecimal"/>
  <field name="netAmount"         class="java.math.BigDecimal"/>
  <field name="checkNumber"       class="java.lang.String"/>
  <field name="checkDate"         class="java.time.LocalDate"/>
  <field name="budgetBookNumber"  class="java.lang.String"/>
  <field name="recipientName"     class="java.lang.String"/>
  <field name="recipientIdNumber" class="java.lang.String"/>

  <!-- ═══════════════════ DERIVED TEXT ═══════════════════ -->
  <!--
    Dates are wrapped in LRM (U+200E) so the bidi algorithm keeps them intact
    inside an Arabic run. Without it a "dd-MM-yyyy" string is reordered on the
    page into "yyyy-MM-dd" and silently reads as a different date.
  -->
  <variable name="AUTH_DATE_TXT" class="java.lang.String">
    <variableExpression><![CDATA[$F{authDate} == null ? ""
      : "‎" + $F{authDate}.format(java.time.format.DateTimeFormatter.ofPattern("dd-MM-yyyy")) + "‎"]]></variableExpression>
  </variable>
  <variable name="CHECK_DATE_TXT" class="java.lang.String">
    <variableExpression><![CDATA[$F{checkDate} == null ? ""
      : "‎" + $F{checkDate}.format(java.time.format.DateTimeFormatter.ofPattern("dd-MM-yyyy")) + "‎"]]></variableExpression>
  </variable>
  <!--
    Drawee bank and branch, both stored on the record. Branch values are
    routinely captured with their own leading noun ("فرع طرابلس"), so the
    branch label is dropped when the stored text already carries it rather
    than printing "فرع فرع طرابلس".
  -->
  <variable name="DRAWEE_BANK_TXT" class="java.lang.String">
    <variableExpression><![CDATA[
      "<b>" + com.dilaw.mohe.report.jasper.ReportText.esc(
                $F{bankName} != null && !$F{bankName}.trim().isEmpty() ? $F{bankName}.trim() : $P{LBL_DEFAULT_BANK}) + "</b>"
      + ($F{bankBranch} == null || $F{bankBranch}.trim().isEmpty() ? ""
         : "  " + ($F{bankBranch}.trim().toLowerCase().contains(
                       $P{LBL_CHECK_BRANCH}.replace(",", "").trim().toLowerCase())
                   ? "" : $P{LBL_CHECK_BRANCH} + " ")
           + "<b>" + com.dilaw.mohe.report.jasper.ReportText.esc($F{bankBranch}.trim()) + "</b>")
    ]]></variableExpression>
  </variable>

  <!-- ═══════════════════ PAGE HEADER (prescribed form head) ═══════════════ -->
  <pageHeader>
    <band height="76" splitType="Stretch">
      <!-- Form serial, top right (RTL leading edge) -->
      <textField>
        <reportElement x="380" y="2" width="175" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_FORM_SERIAL}]]></textFieldExpression>
      </textField>
      <!-- Centre head: republic / form title / ministry -->
      <textField>
        <reportElement x="140" y="2" width="275" height="15"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="10" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{TITLE_01_AR} : ($P{TITLE_01_EN} != null && !$P{TITLE_01_EN}.isEmpty() ? $P{TITLE_01_EN} : $P{TITLE_01_AR})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="140" y="19" width="275" height="20"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="13" isBold="true" isUnderline="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_DOC_TITLE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="140" y="41" width="275" height="15"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="10" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{TITLE_02_AR} : ($P{TITLE_02_EN} != null && !$P{TITLE_02_EN}.isEmpty() ? $P{TITLE_02_EN} : $P{TITLE_02_AR})]]></textFieldExpression>
      </textField>
      <!-- Issuing department (REPORT_TYPE_SETTINGS TITLE_03); hidden when unset -->
      <textField>
        <reportElement x="140" y="56" width="275" height="13">
          <printWhenExpression><![CDATA[($P{IS_RTL} ? $P{TITLE_03_AR} : ($P{TITLE_03_EN} != null && !$P{TITLE_03_EN}.isEmpty() ? $P{TITLE_03_EN} : $P{TITLE_03_AR})) != null
            && !($P{IS_RTL} ? $P{TITLE_03_AR} : ($P{TITLE_03_EN} != null && !$P{TITLE_03_EN}.isEmpty() ? $P{TITLE_03_EN} : $P{TITLE_03_AR})).trim().isEmpty()]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{TITLE_03_AR} : ($P{TITLE_03_EN} != null && !$P{TITLE_03_EN}.isEmpty() ? $P{TITLE_03_EN} : $P{TITLE_03_AR})]]></textFieldExpression>
      </textField>
      <!-- Ministry logo, top left, only when configured -->
      <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
        <reportElement x="0" y="4" width="52" height="48">
          <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null]]></printWhenExpression>
        </reportElement>
        <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
      </image>
      <line><reportElement x="0" y="70" width="555" height="1" forecolor="#000000"/></line>
    </band>
  </pageHeader>

  <!-- ═══════════════════ DETAIL (the voucher body) ═══════════════════ -->
  <detail>
    <band height="640" splitType="Stretch">

      <!-- ── META LINE 1: ministry / province ──────────────────────────── -->
      <textField textAdjust="StretchHeight">
        <reportElement x="300" y="4" width="255" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_MINISTRY_FLD} + "  <b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{ministryName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{ministryName}) : "") + "</b>"]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="150" y="4" width="145" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_DEPT} + "  <b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{deptName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{deptName}) : "") + "</b>"]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="4" width="145" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_PROVINCE} + "  <b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{provinceName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{provinceName}) : "") + "</b>"]]></textFieldExpression>
      </textField>

      <!-- ── META LINE 2: cheque / date / sent to ──────────────────────── -->
      <textField textAdjust="StretchHeight">
        <reportElement x="270" y="22" width="285" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_CHECK_VIA} + "  " + $V{DRAWEE_BANK_TXT}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="150" y="22" width="115" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_DATE} + "  <b>" + $V{CHECK_DATE_TXT} + "</b>"]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="22" width="145" height="14"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SENT_TO} + "  <b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{sentTo}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{sentTo}) : "") + "</b>"]]></textFieldExpression>
      </textField>

      <!-- ══ SECTION أ: main expenditure table ══════════════════════════ -->
      <!-- Header row 1 (RTL: amount rightmost) -->
      <textField>
        <reportElement style="cell" x="477" y="44" width="78" height="48"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <!--
          The column head is the word "amount" alone; the currency underneath it is
          the ministry's own, read from STUDY_CURRENCY_IN. It used to be the single
          label "المبلغ / ريال", so the currency was a piece of English and Arabic
          typed into a label table and could not follow the books.
        -->
        <textFieldExpression><![CDATA[$P{LBL_AMOUNT_CUR}
            + ($P{CURRENCY_NAME} != null && !$P{CURRENCY_NAME}.isEmpty()
                ? "\n" + $P{CURRENCY_NAME} : "")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="357" y="44" width="120" height="24"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_EXPENSE_HEAD}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="295" y="44" width="62" height="48"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_DATE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="237" y="44" width="58" height="48"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_NUMBER}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="30" y="44" width="207" height="48"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_NAME}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="0" y="44" width="30" height="48"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SEQ}]]></textFieldExpression>
      </textField>
      <!-- Header row 2: the four expenditure sub-columns -->
      <textField>
        <reportElement style="cell" x="447" y="68" width="30" height="24"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SUB_1}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="417" y="68" width="30" height="24"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SUB_2}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="387" y="68" width="30" height="24"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SUB_3}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="cell" x="357" y="68" width="30" height="24"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_SUB_4}]]></textFieldExpression>
      </textField>

      <!-- Data row -->
      <textField pattern="#,##0.00">
        <reportElement style="cell" x="477" y="92" width="78" height="26"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{originalAmount} != null ? $F{originalAmount} : java.math.BigDecimal.ZERO]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="cell" x="357" y="92" width="120" height="26"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{paymentPurpose} != null ? $F{paymentPurpose} : ""]]></textFieldExpression>
      </textField>
      <textField>
