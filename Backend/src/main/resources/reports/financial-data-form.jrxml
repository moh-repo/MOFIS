<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
  "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="financial-data-form"
  pageWidth="595" pageHeight="842"
  columnWidth="555" leftMargin="20" rightMargin="20"
  topMargin="10" bottomMargin="15"
  whenNoDataType="AllSectionsNoDetail">

  <!-- STYLES -->
  <style name="defaultStyle" isDefault="true" fontName="Cairo" fontSize="9"/>
  <style name="headerBg">
    <box>
      <pen lineWidth="0.5" lineColor="#3a1422"/>
    </box>
  </style>

  <parameter name="IS_RTL"       class="java.lang.Boolean"><defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression></parameter>
  <parameter name="LANG"         class="java.lang.String"><defaultValueExpression><![CDATA["ar"]]></defaultValueExpression></parameter>
  <parameter name="LOGO_IMAGE"   class="java.io.InputStream"/>
  <parameter name="TITLE_01"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_04"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_05"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_COUNT"    class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_1"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_2"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_3"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_4"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_5"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_1"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_2"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_3"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_4"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_5"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_DATE"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="FOOTER_TEXT" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- Column headers -->
  <parameter name="COL_ROW_NO"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_STUDENT_NAME" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_DEGREE"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_MAJOR"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_COUNTRY"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_STATUS"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_AMOUNT"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_DECISION_NO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- Summary labels -->
  <parameter name="LBL_TOTAL_STUDENTS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_AMOUNT"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_GENERATED"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_PAGE"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_OF"             class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIGNATORY"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- Filter values shown in header -->
  <parameter name="FILTER_YEAR"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="FILTER_QUARTER" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="FILTER_COUNTRY" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_AR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_AR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_AR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_EN" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_EN" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_EN" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_TITLE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="PRINTED_BY" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <field name="studentId"               class="java.lang.Integer"/>
  <field name="studentName"             class="java.lang.String"/>
  <field name="studentDegreeName"       class="java.lang.String"/>
  <field name="studentMajorName"        class="java.lang.String"/>
  <field name="studentCountryName"      class="java.lang.String"/>
  <field name="studentStudyStatusName"  class="java.lang.String"/>
  <field name="studentAmount"           class="java.lang.Integer"/>
  <field name="studentDelegateDecisionNo" class="java.lang.Integer"/>
  <field name="studentStudyNoOfYears"   class="java.lang.Integer"/>

  <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
    <variableExpression><![CDATA[$F{studentId}]]></variableExpression>
      <initialValueExpression><![CDATA[0]]></initialValueExpression>
  </variable>
  <variable name="TOTAL_AMOUNT" class="java.lang.Long" calculation="Sum">
    <variableExpression><![CDATA[$F{studentAmount} != null ? $F{studentAmount}.longValue() : 0L]]></variableExpression>
      <initialValueExpression><![CDATA[0L]]></initialValueExpression>
  </variable>


  <columnHeader>
    <band height="22" splitType="Stretch">
      <!-- Column header background -->
      <rectangle>
        <reportElement x="0" y="0" width="555" height="22" backcolor="#722030" forecolor="#722030"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <!-- Border below column header -->
      <line>
        <reportElement x="0" y="21" width="555" height="1" forecolor="#c4922a"/>
      </line>

      <!-- RTL column order: rightmost = first in Arabic reading -->
      <!-- Col: # (row number) -->
      <textField>
        <reportElement x="515" y="0" width="40" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_ROW_NO}]]></textFieldExpression>
      </textField>
      <!-- Col: Student Name -->
      <textField>
        <reportElement x="405" y="0" width="110" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_STUDENT_NAME}]]></textFieldExpression>
      </textField>
      <!-- Col: Degree -->
      <textField>
        <reportElement x="350" y="0" width="55" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_DEGREE}]]></textFieldExpression>
      </textField>
      <!-- Col: Major -->
      <textField>
        <reportElement x="255" y="0" width="95" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_MAJOR}]]></textFieldExpression>
      </textField>
      <!-- Col: Country -->
      <textField>
        <reportElement x="180" y="0" width="75" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_COUNTRY}]]></textFieldExpression>
      </textField>
      <!-- Col: Status -->
      <textField>
        <reportElement x="100" y="0" width="80" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_STATUS}]]></textFieldExpression>
      </textField>
      <!-- Col: Amount -->
      <textField>
        <reportElement x="40" y="0" width="60" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_AMOUNT}]]></textFieldExpression>
      </textField>
      <!-- Col: Decision No -->
      <textField>
        <reportElement x="0" y="0" width="40" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_DECISION_NO}]]></textFieldExpression>
      </textField>

      <!-- Vertical dividers -->
      <line><reportElement x="40"  y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
      <line><reportElement x="100" y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
      <line><reportElement x="180" y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
      <line><reportElement x="255" y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
      <line><reportElement x="350" y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
      <line><reportElement x="405" y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
      <line><reportElement x="515" y="0" width="1" height="22" forecolor="#5a1a2a"/></line>
    </band>
  </columnHeader>

  <detail>
    <band height="19" splitType="Stretch">
      <!-- Alternating row background -->
      <rectangle>
        <reportElement x="0" y="0" width="555" height="19" backcolor="#fdf4f6" forecolor="#fdf4f6">
  <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
</reportElement>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <!-- Row bottom border -->
      <line>
        <reportElement x="0" y="18" width="555" height="1" forecolor="#e8c0c8"/>
      </line>

      <!-- Row # -->
      <textField>
        <reportElement x="515" y="0" width="40" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$V{ROW_NUMBER}]]></textFieldExpression>
      </textField>
      <!-- Student Name -->
      <textField textAdjust="CutText">
        <reportElement x="405" y="0" width="110" height="19"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentName} != null ? $F{studentName} : ""]]></textFieldExpression>
      </textField>
      <!-- Degree -->
      <textField>
        <reportElement x="350" y="0" width="55" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentDegreeName} != null ? $F{studentDegreeName} : ""]]></textFieldExpression>
      </textField>
      <!-- Major -->
      <textField>
        <reportElement x="255" y="0" width="95" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentMajorName} != null ? $F{studentMajorName} : ""]]></textFieldExpression>
      </textField>
      <!-- Country -->
      <textField>
        <reportElement x="180" y="0" width="75" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentCountryName} != null ? $F{studentCountryName} : ""]]></textFieldExpression>
      </textField>
      <!-- Status -->
      <textField>
        <reportElement x="100" y="0" width="80" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentStudyStatusName} != null ? $F{studentStudyStatusName} : ""]]></textFieldExpression>
      </textField>
      <!-- Amount -->
      <textField pattern="#,##0">
        <reportElement x="40" y="0" width="60" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentAmount} != null ? $F{studentAmount} : 0]]></textFieldExpression>
      </textField>
      <!-- Decision No -->
      <textField>
        <reportElement x="0" y="0" width="40" height="19"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentDelegateDecisionNo} != null ? $F{studentDelegateDecisionNo}.toString() : ""]]></textFieldExpression>
      </textField>

      <!-- Vertical dividers (light) -->
      <line><reportElement x="40"  y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
      <line><reportElement x="100" y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
      <line><reportElement x="180" y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
      <line><reportElement x="255" y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
      <line><reportElement x="350" y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
      <line><reportElement x="405" y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
      <line><reportElement x="515" y="0" width="1" height="19" forecolor="#e8c0c8"/></line>
    </band>
  </detail>

  <summary>
    <band height="26" splitType="Stretch">
      <!-- Totals bar -->
      <rectangle>
        <reportElement x="0" y="0" width="555" height="26" backcolor="#3a1422" forecolor="#3a1422"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <!-- Total Students label -->
      <textField>
        <reportElement x="390" y="0" width="120" height="26" forecolor="#FFFFFF"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_TOTAL_STUDENTS} + ":  " + $V{ROW_NUMBER}]]></textFieldExpression>
      </textField>
      <line><reportElement x="390" y="0" width="1" height="26" forecolor="#5a1a2a"/></line>
      <!-- Total Amount label -->
      <textField pattern="#,##0">
        <reportElement x="0" y="0" width="390" height="26" forecolor="#FFFFFF"/>
        <textElement textAlignment="Left" verticalAlignment="Middle">
          <font fontName="Cairo" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_TOTAL_AMOUNT} + ":  " + String.format("%,d", $V{TOTAL_AMOUNT})]]></textFieldExpression>
      </textField>

    </band>
  </summary>

  <!-- ═══════════════════ PAGE FOOTER ═══════════════════ -->
<!-- OFFICIAL-LAYOUT:BEGIN (generated by scripts/apply_official_layout.py) -->
  <pageHeader>
    <band height="118" splitType="Stretch">
      <textField>
        <reportElement x="363" y="4" width="192" height="16" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="10" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_01_AR} != null && !$P{TITLE_01_AR}.isEmpty() ? $P{TITLE_01_AR} : $P{TITLE_01}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="363" y="20" width="192" height="14" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_02_AR}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="363" y="34" width="192" height="13" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_03_AR}]]></textFieldExpression>
      </textField>
      <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
        <reportElement x="247" y="2" width="60" height="56">
          <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null]]></printWhenExpression>
        </reportElement>
        <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
      </image>
      <textField>
        <reportElement x="0" y="4" width="192" height="16" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_01_EN}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="20" width="192" height="14" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_02_EN}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="34" width="192" height="13" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_03_EN}]]></textFieldExpression>
      </textField>
      <rectangle>
        <reportElement x="0" y="62" width="555" height="2" backcolor="#c4922a" forecolor="#c4922a"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <line><reportElement x="0" y="66" width="555" height="1" forecolor="#3a1422"/></line>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="72" width="555" height="22" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="14" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{REPORT_TITLE} != null && !$P{REPORT_TITLE}.isEmpty() ? $P{REPORT_TITLE} : ($P{TITLE_02} != null && !$P{TITLE_02}.isEmpty() ? $P{TITLE_02} : $P{TITLE_03})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="98" width="267" height="12" forecolor="#7a3040"/>
        <textElement textAlignment="Left" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_GENERATED} + ": " + $P{REPORT_DATE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="288" y="98" width="267" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{PRINTED_BY} != null && !$P{PRINTED_BY}.isEmpty()]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{PRINTED_BY}]]></textFieldExpression>
      </textField>
    </band>
  </pageHeader>
  <pageFooter>
    <band height="42" splitType="Stretch">
      <line><reportElement x="0" y="0" width="555" height="1" forecolor="#c4922a"/></line>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="4" width="555" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{FOOTER_TEXT} != null && !$P{FOOTER_TEXT}.isEmpty()]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{FOOTER_TEXT}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="20" width="267" height="12" forecolor="#7a3040"/>
        <textElement textAlignment="Left" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_GENERATED} + ": " + $P{REPORT_DATE} + ($P{PRINTED_BY} != null && !$P{PRINTED_BY}.isEmpty() ? "  |  " + $P{PRINTED_BY} : "")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="405" y="20" width="150" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_PAGE} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Report">
        <reportElement x="355" y="20" width="46" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_OF} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="405" y="20" width="102" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[!$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_PAGE} + " " + $V{PAGE_NUMBER} + " " + $P{LBL_OF}]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Report">
        <reportElement x="509" y="20" width="46" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[!$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Left" verticalAlignment="Middle">
