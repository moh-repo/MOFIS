  </columnHeader>

  <!-- ══ DETAIL: one student ═════════════════════════════════════════════ -->
  <detail>
    <band height="34" splitType="Prevent">
      <textField>
        <reportElement style="cell" stretchType="ContainerHeight" x="531" y="0" width="24" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$V{ROW_NUMBER}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight" isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="413" y="0" width="118" height="34"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentName}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="391" y="0" width="22" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left" runDirection="RTL">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{entityName}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="369" y="0" width="22" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left" runDirection="RTL">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studyCountryInName}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="343" y="0" width="26" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentDelegationDecisionYear}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="319" y="0" width="24" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left" runDirection="RTL">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentDegreeName}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight" isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="271" y="0" width="48" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentMajorName}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="239" y="0" width="32" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentDelegateDecisionNo} != null ? String.valueOf($F{studentDelegateDecisionNo}) : ""]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="219" y="0" width="20" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentStudyNoOfYears} != null ? String.valueOf($F{studentStudyNoOfYears}) : ""]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="199" y="0" width="20" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{currentLevelLabel}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="firstReceipt" stretchType="ContainerHeight" x="169" y="0" width="30" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentFirstReceiptOfDue} != null ? String.valueOf($F{studentFirstReceiptOfDue}) : ""]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="131" y="0" width="38" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentAmount} != null ? "$" + String.format("%,d", $F{studentAmount}) : ""]]></textFieldExpression>
      </textField>
      <!-- Signature cell: blank for the student to sign, unless a payment-stop flag is recorded -->
      <textField textAdjust="StretchHeight" isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="86" y="0" width="45" height="34" forecolor="#7A0000"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="6" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentNote2}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight" isBlankWhenNull="true">
        <reportElement style="cell" stretchType="ContainerHeight" x="0" y="0" width="86" height="34"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="5.5"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{studentNote1}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <!-- ══ SUMMARY: grand total ════════════════════════════════════════════ -->
  <summary>
    <band height="22" splitType="Stretch">
      <textField>
        <reportElement style="totalCell" x="169" y="0" width="386" height="22"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="10" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_GRAND_TOTAL} + "   (" + $P{LBL_STUDENTS} + ": " + $V{ROW_NUMBER} + ")"]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="totalCell" x="131" y="0" width="38" height="22"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA["$" + String.format("%,d", $V{TOTAL_AMOUNT_SUM})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="totalCell" x="0" y="0" width="131" height="22"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA["$" + String.format("%,d", $V{TOTAL_AMOUNT_SUM})]]></textFieldExpression>
      </textField>
    </band>
  </summary>

  <!-- ══ PAGE FOOTER: five signatories on every page, as on the sheet ════ -->
  <pageFooter>
    <band height="60" splitType="Stretch">
      <!-- Signatory 1 (rightmost, RTL leading edge) -->
      <textField>
