          <font fontName="Cairo" size="6" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_LEVEL}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="head" x="169" y="0" width="30" height="46"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left" runDirection="RTL">
          <font fontName="Cairo" size="6.5" isBold="true"/>
        </textElement>
