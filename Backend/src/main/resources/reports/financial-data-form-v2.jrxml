          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_AMOUNT}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="head" x="86" y="0" width="45" height="46"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_STUDENT_SIGNATURE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="head" x="0" y="0" width="86" height="46"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_NOTES}]]></textFieldExpression>
      </textField>
