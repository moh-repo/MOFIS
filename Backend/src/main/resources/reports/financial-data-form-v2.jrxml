        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{SIG_NAME_4}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="111" y="18" width="111" height="24">
          <printWhenExpression><![CDATA[$P{SIG_COUNT} >= 4]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Top" runDirection="RTL">
