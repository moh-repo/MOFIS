<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
  "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="student-financial-statement"
  pageWidth="595" pageHeight="842"
  orientation="Portrait"
  columnWidth="555" leftMargin="20" rightMargin="20"
  topMargin="10" bottomMargin="15"
  whenNoDataType="AllSectionsNoDetail">

  <!-- STYLES -->
  <style name="defaultStyle" isDefault="true" fontName="Cairo" fontSize="8"/>

  <parameter name="IS_RTL"       class="java.lang.Boolean"><defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression></parameter>
  <parameter name="LANG"         class="java.lang.String"><defaultValueExpression><![CDATA["ar"]]></defaultValueExpression></parameter>
  <parameter name="LOGO_IMAGE"   class="java.io.InputStream"/>
  <parameter name="TITLE_01"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_04"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_05"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_AR"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_AR"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_AR"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_EN"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_EN"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_EN"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_TITLE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="PRINTED_BY"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_COUNT"    class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_1"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_2"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_3"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_4"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_5"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_1"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_2"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_3"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_4"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_5"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_DATE"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="FOOTER_TEXT"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- Student header block -->
  <parameter name="STUDENT_NAME_HDR"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="STUDENT_ID_HDR"         class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="STUDENT_UNIVERSITY_HDR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="STUDENT_COUNTRY_HDR"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- Totals (computed by the service across finance + fees + books + loans) -->
  <parameter name="TOTAL_RECEIVED" class="java.lang.Long"><defaultValueExpression><![CDATA[0L]]></defaultValueExpression></parameter>
  <parameter name="TOTAL_WAFAR"    class="java.lang.Long"><defaultValueExpression><![CDATA[0L]]></defaultValueExpression></parameter>
  <parameter name="TOTAL_NET"      class="java.lang.Long"><defaultValueExpression><![CDATA[0L]]></defaultValueExpression></parameter>
  <parameter name="TOTAL_FEES"     class="java.lang.Long"><defaultValueExpression><![CDATA[0L]]></defaultValueExpression></parameter>
  <parameter name="TOTAL_BOOKS"    class="java.lang.Long"><defaultValueExpression><![CDATA[0L]]></defaultValueExpression></parameter>
  <parameter name="TOTAL_LOANS"    class="java.lang.Long"><defaultValueExpression><![CDATA[0L]]></defaultValueExpression></parameter>
  <!-- Labels -->
  <parameter name="LBL_DOC_TITLE"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_STUDENT_NAME"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_STUDENT_ID"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_UNIVERSITY"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_STUDY_COUNTRY"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_ROW_NO"         class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_YEAR_MONTH"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_RECEIVED_AMOUNT" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_WAFAR"          class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_WAFAR_TYPE"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_NET_AMOUNT"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_CURRENCY"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_BANK"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_STATUS"         class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_CHECK_NO"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_QUARTER_TOTAL"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_RECEIVED" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_WAFAR"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_NET"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_FEES"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_BOOKS"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_LOANS"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_TOTAL_RECORDS"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_GENERATED"      class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_PAGE"           class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_OF"             class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_NO_DATA"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIGNATORY" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <field name="rowKey"             class="java.lang.String"/>
  <field name="quarterLabel"       class="java.lang.String"/>
  <field name="receivedYear"       class="java.lang.Integer"/>
  <field name="receivedMonth"      class="java.lang.Integer"/>
  <field name="receivedAmount"     class="java.lang.Integer"/>
  <field name="wafarAmount"        class="java.lang.Integer"/>
  <field name="wafarTypeName"      class="java.lang.String"/>
  <field name="netAmount"          class="java.lang.Integer"/>
  <field name="currencyName"       class="java.lang.String"/>
  <field name="bankName"           class="java.lang.String"/>
  <field name="bankBranchName"     class="java.lang.String"/>
  <field name="receivedStatusName" class="java.lang.String"/>
  <field name="checkNo"            class="java.lang.String"/>

  <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
    <variableExpression><![CDATA[$F{rowKey}]]></variableExpression>
      <initialValueExpression><![CDATA[0]]></initialValueExpression>
  </variable>
  <variable name="Q_RECEIVED" class="java.lang.Long" resetType="Group" resetGroup="QuarterGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{receivedAmount} != null ? $F{receivedAmount}.longValue() : 0L]]></variableExpression>
      <initialValueExpression><![CDATA[0L]]></initialValueExpression>
  </variable>
  <variable name="Q_WAFAR" class="java.lang.Long" resetType="Group" resetGroup="QuarterGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{wafarAmount} != null ? $F{wafarAmount}.longValue() : 0L]]></variableExpression>
      <initialValueExpression><![CDATA[0L]]></initialValueExpression>
  </variable>
  <variable name="Q_NET" class="java.lang.Long" resetType="Group" resetGroup="QuarterGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{netAmount} != null ? $F{netAmount}.longValue() : 0L]]></variableExpression>
      <initialValueExpression><![CDATA[0L]]></initialValueExpression>
  </variable>

  <group name="QuarterGroup">
    <groupExpression><![CDATA[$F{quarterLabel}]]></groupExpression>
    <groupHeader>
      <band height="18" splitType="Stretch">
        <rectangle>
          <reportElement x="0" y="0" width="555" height="17" backcolor="#f7ecec" forecolor="#f7ecec"/>
          <graphicElement><pen lineWidth="0.0"/></graphicElement>
        </rectangle>
        <textField>
          <reportElement x="5" y="0" width="545" height="17" forecolor="#3a1422"/>
          <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
            <font fontName="Cairo" size="9" isBold="true"/>
          </textElement>
          <textFieldExpression><![CDATA[$F{quarterLabel} != null ? $F{quarterLabel} : ""]]></textFieldExpression>
        </textField>
        <line><reportElement x="0" y="17" width="555" height="1" forecolor="#e8c0c8"/></line>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="17" splitType="Stretch">
        <rectangle>
          <reportElement x="0" y="0" width="555" height="16" backcolor="#f7f2e6" forecolor="#f7f2e6"/>
          <graphicElement><pen lineWidth="0.0"/></graphicElement>
        </rectangle>
        <textField>
          <reportElement x="360" y="0" width="190" height="16" forecolor="#7a5b12"/>
          <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
            <font fontName="Cairo" size="8" isBold="true"/>
          </textElement>
          <textFieldExpression><![CDATA[$P{LBL_QUARTER_TOTAL}]]></textFieldExpression>
        </textField>
        <textField pattern="#,##0">
          <reportElement x="408" y="0" width="62" height="16" forecolor="#7a5b12"/>
          <textElement textAlignment="Center" verticalAlignment="Middle">
            <font fontName="Cairo" size="8" isBold="true"/>
          </textElement>
          <textFieldExpression><![CDATA[$V{Q_RECEIVED}]]></textFieldExpression>
        </textField>
        <textField pattern="#,##0">
          <reportElement x="353" y="0" width="55" height="16" forecolor="#7a5b12"/>
          <textElement textAlignment="Center" verticalAlignment="Middle">
            <font fontName="Cairo" size="8" isBold="true"/>
          </textElement>
          <textFieldExpression><![CDATA[$V{Q_WAFAR}]]></textFieldExpression>
        </textField>
        <textField pattern="#,##0">
          <reportElement x="229" y="0" width="62" height="16" forecolor="#7a5b12"/>
          <textElement textAlignment="Center" verticalAlignment="Middle">
            <font fontName="Cairo" size="8" isBold="true"/>
          </textElement>
          <textFieldExpression><![CDATA[$V{Q_NET}]]></textFieldExpression>
        </textField>
        <line><reportElement x="0" y="16" width="555" height="1" forecolor="#c4922a"/></line>
      </band>
    </groupFooter>
  </group>


  <columnHeader>
    <band height="22" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="0" width="555" height="22" backcolor="#3a1422" forecolor="#3a1422"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <line><reportElement x="0" y="21" width="555" height="1" forecolor="#c4922a"/></line>
      <!-- RTL column order: #(right) | Year/Month | Received | Wafar | Wafar Type | Net | Currency | Bank/Branch | Status | Check No(left) -->
      <textField>
        <reportElement x="530" y="0" width="25" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_ROW_NO}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="470" y="0" width="60" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_YEAR_MONTH}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="408" y="0" width="62" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_RECEIVED_AMOUNT}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="353" y="0" width="55" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_WAFAR}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="291" y="0" width="62" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_WAFAR_TYPE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="229" y="0" width="62" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_NET_AMOUNT}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="181" y="0" width="48" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_CURRENCY}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="85" y="0" width="96" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_BANK}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="30" y="0" width="55" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_STATUS}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="0" width="30" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{COL_CHECK_NO}]]></textFieldExpression>
      </textField>
    </band>
  </columnHeader>

  <detail>
    <band height="17" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="0" width="555" height="17" backcolor="#fdf4f6" forecolor="#fdf4f6">
          <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <line><reportElement x="0" y="16" width="555" height="1" forecolor="#e8c0c8"/></line>
      <textField>
        <reportElement x="530" y="0" width="25" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$V{ROW_NUMBER}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="470" y="0" width="60" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[($F{receivedYear} != null ? String.valueOf($F{receivedYear}) : "-") + ($F{receivedMonth} != null ? " / " + $F{receivedMonth} : "")]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0">
        <reportElement x="408" y="0" width="62" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{receivedAmount} != null ? $F{receivedAmount} : 0]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0">
        <reportElement x="353" y="0" width="55" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{wafarAmount} != null ? $F{wafarAmount} : 0]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="291" y="0" width="62" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{wafarTypeName} != null ? $F{wafarTypeName} : ""]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0">
        <reportElement x="229" y="0" width="62" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{netAmount} != null ? $F{netAmount} : 0]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="181" y="0" width="48" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{currencyName} != null ? $F{currencyName} : ""]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="85" y="0" width="96" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[($F{bankName} != null ? $F{bankName} : "") + ($F{bankBranchName} != null && !$F{bankBranchName}.isEmpty() ? " / " + $F{bankBranchName} : "")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="30" y="0" width="55" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{receivedStatusName} != null ? $F{receivedStatusName} : ""]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="0" width="30" height="17"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="6"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{checkNo} != null ? $F{checkNo} : ""]]></textFieldExpression>
      </textField>
    </band>
  </detail>


  <summary>
    <band height="96" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="4" width="555" height="84" backcolor="#fdf4f6" forecolor="#e8c0c8"/>
        <graphicElement><pen lineWidth="0.6"/></graphicElement>
      </rectangle>
      <!-- Right column: finance totals -->
      <textField>
        <reportElement x="290" y="12" width="255" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_TOTAL_RECEIVED} + ": </b>" + String.format("%,d", $P{TOTAL_RECEIVED})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="290" y="34" width="255" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_TOTAL_WAFAR} + ": </b>" + String.format("%,d", $P{TOTAL_WAFAR})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="290" y="56" width="255" height="16" forecolor="#3a1422"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="10" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_TOTAL_NET} + ": </b>" + String.format("%,d", $P{TOTAL_NET})]]></textFieldExpression>
      </textField>
      <!-- Left column: fees / books / loans -->
      <textField>
        <reportElement x="15" y="12" width="255" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_TOTAL_FEES} + ": </b>" + String.format("%,d", $P{TOTAL_FEES})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="15" y="34" width="255" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_TOTAL_BOOKS} + ": </b>" + String.format("%,d", $P{TOTAL_BOOKS})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="15" y="56" width="255" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_TOTAL_LOANS} + ": </b>" + String.format("%,d", $P{TOTAL_LOANS})]]></textFieldExpression>
      </textField>
