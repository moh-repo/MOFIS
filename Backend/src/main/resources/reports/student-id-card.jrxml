        </reportElement>
        <imageExpression><![CDATA[$P{STUDENT_PHOTO}]]></imageExpression>
      </image>
      <!-- Student name -->
      <textField textAdjust="StretchHeight">
        <reportElement x="92" y="66" width="268" height="22" forecolor="#3a1422"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="11" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[com.dilaw.mohe.report.jasper.ReportText.esc($F{studentName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{studentName}) : ""]]></textFieldExpression>
      </textField>
      <!-- Field rows: label + value, RTL -->
      <textField>
        <reportElement x="92" y="94" width="268" height="18"/>
