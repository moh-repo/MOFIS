      </rectangle>
      <!-- Card header strip -->
      <rectangle>
        <reportElement x="79" y="26" width="396" height="30" backcolor="#3a1422" forecolor="#3a1422"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <textField>
        <reportElement x="79" y="26" width="396" height="30" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
