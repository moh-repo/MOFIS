<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
  "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="audit-trail"
  pageWidth="842" pageHeight="595"
  orientation="Landscape"

  columnWidth="802" leftMargin="20" rightMargin="20"
  topMargin="10" bottomMargin="15"
  whenNoDataType="AllSectionsNoDetail">

  <!-- STYLE -->
  <style name="defaultStyle" isDefault="true" fontName="Cairo" fontSize="9"/>

  <!--
    Column widths are a palindrome (96,86,74,145,145,74,86,96) so the Arabic layout mirrors the English one exactly; every cell picks
    its field from IS_RTL, which only aligns if slot N and slot 9-N match.
  -->

  <!-- PARAMETERS -->
  <parameter name="IS_RTL"      class="java.lang.Boolean"><defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression></parameter>
  <parameter name="LANG"        class="java.lang.String"><defaultValueExpression><![CDATA["ar"]]></defaultValueExpression></parameter>
  <parameter name="LOGO_IMAGE"  class="java.io.InputStream"/>
  <parameter name="REPORT_DATE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="FOOTER_TEXT" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="REPORT_TITLE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="PRINTED_BY"  class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <!-- The generated masthead references TITLE_02/TITLE_03; declare the full set. -->
  <parameter name="TITLE_02"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_04"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_05"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <parameter name="COL_TIMESTAMP" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_OPERATION" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_TABLE"     class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_RECORD"    class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_COLUMNS"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_CHANGED_BY" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_ATTACHE"   class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="COL_IP"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <parameter name="LBL_TOTAL_RECORDS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_NO_DATA"       class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <!-- The period this document covers; an audit page without it cannot be checked. -->
  <parameter name="RANGE_NOTE"        class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_AR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_AR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_AR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_01_EN" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_02_EN" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="TITLE_03_EN" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_COUNT" class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
  <parameter name="LBL_GENERATED" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_PAGE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_OF" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="LBL_SIGNATORY" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_1" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_1" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_2" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_2" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_3" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_3" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_4" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_4" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_NAME_5" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
  <parameter name="SIG_POS_5" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>

  <!-- FIELDS -->
  <field name="changedAt"      class="java.time.LocalDateTime"/>
  <field name="operation"      class="java.lang.String"/>
  <field name="tableName"      class="java.lang.String"/>
  <field name="recordId"       class="java.lang.String"/>
  <field name="changedColumns" class="java.lang.String"/>
  <field name="changedBy"      class="java.lang.String"/>
  <field name="countryName"    class="java.lang.String"/>
  <field name="ipAddress"      class="java.lang.String"/>

  <!-- VARIABLES -->
  <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
    <variableExpression><![CDATA[$F{operation}]]></variableExpression>
    <initialValueExpression><![CDATA[0]]></initialValueExpression>
  </variable>

  <!-- RANGE BANNER -->
  <title>
    <band height="20" splitType="Stretch">
      <textField>
        <reportElement x="0" y="2" width="802" height="16" forecolor="#2c3e50"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="9" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{RANGE_NOTE} == null ? "" : $P{RANGE_NOTE}]]></textFieldExpression>
      </textField>
    </band>
  </title>

  <!-- COLUMN HEADER -->
  <columnHeader>
    <band height="22" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="0" width="802" height="22" backcolor="#34495e" forecolor="#34495e"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <line><reportElement x="0" y="21" width="802" height="1" forecolor="#c4922a"/></line>

      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="96" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_IP} : $P{COL_TIMESTAMP}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="96" y="0" width="86" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_ATTACHE} : $P{COL_OPERATION}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="182" y="0" width="74" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_CHANGED_BY} : $P{COL_TABLE}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="256" y="0" width="145" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_RECORD} : $P{COL_COLUMNS}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="401" y="0" width="145" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_COLUMNS} : $P{COL_RECORD}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="546" y="0" width="74" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_TABLE} : $P{COL_CHANGED_BY}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="620" y="0" width="86" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_OPERATION} : $P{COL_ATTACHE}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="706" y="0" width="96" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? $P{COL_TIMESTAMP} : $P{COL_IP}]]></textFieldExpression>
      </textField>
      <line><reportElement x="96" y="0" width="1" height="22" forecolor="#22303d"/></line>
      <line><reportElement x="182" y="0" width="1" height="22" forecolor="#22303d"/></line>
      <line><reportElement x="256" y="0" width="1" height="22" forecolor="#22303d"/></line>
      <line><reportElement x="401" y="0" width="1" height="22" forecolor="#22303d"/></line>
      <line><reportElement x="546" y="0" width="1" height="22" forecolor="#22303d"/></line>
      <line><reportElement x="620" y="0" width="1" height="22" forecolor="#22303d"/></line>
      <line><reportElement x="706" y="0" width="1" height="22" forecolor="#22303d"/></line>
    </band>
  </columnHeader>

  <!-- DETAIL -->
  <detail>
    <band height="19" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="0" width="802" height="19" backcolor="#f4f6f8" forecolor="#f4f6f8">
          <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <line><reportElement x="0" y="18" width="802" height="1" forecolor="#d6dde3"/></line>

      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="96" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{ipAddress} != null ? $F{ipAddress} : "") : ($F{changedAt} != null ? String.valueOf($F{changedAt}).replace("T", " ") : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="96" y="0" width="86" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{countryName} != null ? $F{countryName} : "") : ($F{operation} != null ? $F{operation} : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="182" y="0" width="74" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{changedBy} != null ? $F{changedBy} : "") : ($F{tableName} != null ? $F{tableName} : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="256" y="0" width="145" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{recordId} != null ? $F{recordId} : "") : ($F{changedColumns} != null ? $F{changedColumns} : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="401" y="0" width="145" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{changedColumns} != null ? $F{changedColumns} : "") : ($F{recordId} != null ? $F{recordId} : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="546" y="0" width="74" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{tableName} != null ? $F{tableName} : "") : ($F{changedBy} != null ? $F{changedBy} : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="620" y="0" width="86" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{operation} != null ? $F{operation} : "") : ($F{countryName} != null ? $F{countryName} : "")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="706" y="0" width="96" height="19" isPrintWhenDetailOverflows="true"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{IS_RTL} ? ($F{changedAt} != null ? String.valueOf($F{changedAt}).replace("T", " ") : "") : ($F{ipAddress} != null ? $F{ipAddress} : "")]]></textFieldExpression>
      </textField>
      <line><reportElement x="96" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
      <line><reportElement x="182" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
      <line><reportElement x="256" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
      <line><reportElement x="401" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
      <line><reportElement x="546" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
      <line><reportElement x="620" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
      <line><reportElement x="706" y="0" width="1" height="19" forecolor="#d6dde3"/></line>
    </band>
  </detail>

  <!-- SUMMARY -->
  <summary>
    <band height="44" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="0" width="802" height="24" backcolor="#22303d" forecolor="#22303d"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <textField>
        <reportElement x="0" y="0" width="802" height="24" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="10" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{LBL_TOTAL_RECORDS} + ": " + $V{ROW_NUMBER}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="28" width="802" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$V{ROW_NUMBER} == null || $V{ROW_NUMBER} == 0]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Cairo" size="8"/></textElement>
        <textFieldExpression><![CDATA[$P{LBL_NO_DATA}]]></textFieldExpression>
      </textField>
    </band>
  </summary>
<!-- OFFICIAL-LAYOUT:BEGIN (generated by scripts/apply_official_layout.py) -->
  <pageHeader>
    <band height="118" splitType="Stretch">
      <textField>
        <reportElement x="510" y="4" width="292" height="16" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="10" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_01_AR} != null && !$P{TITLE_01_AR}.isEmpty() ? $P{TITLE_01_AR} : $P{TITLE_01}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="510" y="20" width="292" height="14" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_02_AR}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="510" y="34" width="292" height="13" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_03_AR}]]></textFieldExpression>
      </textField>
      <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
        <reportElement x="371" y="2" width="60" height="56">
          <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null]]></printWhenExpression>
        </reportElement>
        <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
      </image>
      <textField>
        <reportElement x="0" y="4" width="292" height="16" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_01_EN}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="20" width="292" height="14" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_02_EN}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="34" width="292" height="13" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{TITLE_03_EN}]]></textFieldExpression>
      </textField>
      <rectangle>
        <reportElement x="0" y="62" width="802" height="2" backcolor="#c4922a" forecolor="#c4922a"/>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <line><reportElement x="0" y="66" width="802" height="1" forecolor="#3a1422"/></line>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="72" width="802" height="22" forecolor="#3a1422"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="14" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{REPORT_TITLE} != null && !$P{REPORT_TITLE}.isEmpty() ? $P{REPORT_TITLE} : ($P{TITLE_02} != null && !$P{TITLE_02}.isEmpty() ? $P{TITLE_02} : $P{TITLE_03})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="98" width="391" height="12" forecolor="#7a3040"/>
        <textElement textAlignment="Left" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_GENERATED} + ": " + $P{REPORT_DATE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="411" y="98" width="391" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{PRINTED_BY} != null && !$P{PRINTED_BY}.isEmpty()]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{PRINTED_BY}]]></textFieldExpression>
      </textField>
    </band>
  </pageHeader>
  <pageFooter>
    <band height="42" splitType="Stretch">
      <line><reportElement x="0" y="0" width="802" height="1" forecolor="#c4922a"/></line>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="4" width="802" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{FOOTER_TEXT} != null && !$P{FOOTER_TEXT}.isEmpty()]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{FOOTER_TEXT}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="20" width="391" height="12" forecolor="#7a3040"/>
        <textElement textAlignment="Left" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_GENERATED} + ": " + $P{REPORT_DATE} + ($P{PRINTED_BY} != null && !$P{PRINTED_BY}.isEmpty() ? "  |  " + $P{PRINTED_BY} : "")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="652" y="20" width="150" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_PAGE} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Report">
        <reportElement x="602" y="20" width="46" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_OF} + " " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="652" y="20" width="102" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[!$P{IS_RTL}]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle">
          <font fontName="Cairo" size="7"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{LBL_PAGE} + " " + $V{PAGE_NUMBER} + " " + $P{LBL_OF}]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Report">
        <reportElement x="756" y="20" width="46" height="12" forecolor="#7a3040">
          <printWhenExpression><![CDATA[!$P{IS_RTL}]]></printWhenExpression>
