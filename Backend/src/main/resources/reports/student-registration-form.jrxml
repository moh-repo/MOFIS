  <field name="lastQuarterLabel"     class="java.lang.String"/>
  <field name="currentQuarterLabel"  class="java.lang.String"/>


  <detail>
    <!-- Identity strip with photo -->
    <band height="126" splitType="Stretch">
      <!-- Photo placeholder + photo (left side; form text reads RTL from right) -->
      <rectangle>
        <reportElement x="0" y="6" width="94" height="114" backcolor="#f7ecec" forecolor="#d4a870"/>
        <graphicElement><pen lineWidth="0.6"/></graphicElement>
      </rectangle>
      <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
        <reportElement x="2" y="8" width="90" height="110">
          <printWhenExpression><![CDATA[$P{STUDENT_PHOTO} != null]]></printWhenExpression>
        </reportElement>
        <imageExpression><![CDATA[$P{STUDENT_PHOTO}]]></imageExpression>
      </image>
      <!-- Name + ID + passport -->
      <textField textAdjust="StretchHeight">
        <reportElement x="110" y="14" width="445" height="24" forecolor="#3a1422"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="13" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[(com.dilaw.mohe.report.jasper.ReportText.esc($F{studentName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{studentName}) : "")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="110" y="46" width="445" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_STUDENT_ID} + ": </b>" + ($F{studentId} != null ? String.valueOf($F{studentId}) : "-")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="110" y="66" width="445" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_PASSPORT_NO} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{passportNumber}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{passportNumber}) : "-")]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="110" y="86" width="445" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_STUDY_STATUS} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{studyStatusName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{studyStatusName}) : "-")]]></textFieldExpression>
      </textField>
    </band>

    <!-- Sectioned label/value grid -->
    <band height="520" splitType="Stretch">
      <!-- ── Personal ── -->
      <textField>
        <reportElement style="secHdr" x="0" y="0" width="555" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA["  " + $P{LBL_SEC_PERSONAL} + "  "]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="278" y="20" width="277" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_GENDER} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{genderName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{genderName}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="0" y="20" width="270" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_BIRTH_DATE} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{birthDate}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{birthDate}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="278" y="40" width="277" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_BIRTH_PLACE} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{birthPlace}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{birthPlace}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="0" y="40" width="270" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_AGE} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{age}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{age}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="278" y="60" width="277" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_HOME_COUNTRY} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{homeCountryName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{homeCountryName}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="0" y="60" width="270" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_HOME_GOV} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{homeGovName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{homeGovName}) : "-")]]></textFieldExpression>
