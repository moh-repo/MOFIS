      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="278" y="146" width="277" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_PASSPORT_EXPIRE} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{passportExpireDate}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{passportExpireDate}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="0" y="146" width="270" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
