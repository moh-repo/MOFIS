    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="student-registration-form"
  pageWidth="595" pageHeight="842"
  orientation="Portrait"
  columnWidth="555" leftMargin="20" rightMargin="20"
  topMargin="10" bottomMargin="15"
  whenNoDataType="AllSectionsNoDetail">

  <!-- STYLES -->
  <style name="defaultStyle" isDefault="true" fontName="Cairo" fontSize="8"/>
  <style name="secHdr" mode="Opaque" backcolor="#3a1422" forecolor="#FFFFFF" fontName="Cairo" fontSize="9" isBold="true"/>
  <style name="fieldCell" fontName="Cairo" fontSize="8">
    <box>
      <bottomPen lineWidth="0.4" lineColor="#e8c0c8"/>
    </box>
  </style>

