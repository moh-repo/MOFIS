      <!-- ── Academic ── -->
      <textField>
        <reportElement style="secHdr" x="0" y="172" width="555" height="16"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL">
          <font fontName="Cairo" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA["  " + $P{LBL_SEC_ACADEMIC} + "  "]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="278" y="192" width="277" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
          <font fontName="Cairo" size="8"/>
        </textElement>
        <textFieldExpression><![CDATA["<b>" + $P{LBL_DEGREE} + ": </b>" + (com.dilaw.mohe.report.jasper.ReportText.esc($F{degreeName}) != null ? com.dilaw.mohe.report.jasper.ReportText.esc($F{degreeName}) : "-")]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement style="fieldCell" x="0" y="192" width="270" height="18"/>
        <textElement textAlignment="Right" verticalAlignment="Middle" runDirection="RTL" markup="styled">
